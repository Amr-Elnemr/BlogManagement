{
  "name": "blog_management",
  "version": "1.0.0",
  "description": "Blog management backend in Express js",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "dotenvx run -f .env.testing -f .env -- jest --watchAll --verbose --runInBand",
    "test:coverage": "dotenvx run -f .env.testing -f .env -- jest --watchAll --verbose --runInBand --coverage",
    "test:leaks": "jest --detectOpenHandles"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.51.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "bcrypt": "^6.0.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "@types/supertest": "^6.0.3",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "author": "Amr Essam",
  "license": "ISC"
}
